{
  "manifest_version": 3,
  "name": "Quiet X — allowlist timeline",
  "version": "1.5.2",
  "description": "Blocks everything on X except accounts you approve. Kills the For You feed, media, metrics and infinite scroll.",
  "permissions": ["storage", "scripting", "tabs", "alarms"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "background": { "service_worker": "src/background.js" },
  "action": {
    "default_popup": "src/ui/popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "128": "icons/128.png" }
  },
  "options_page": "src/ui/options.html",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/defaults.js", "src/content/content.js"],
      "css": ["src/content/content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": []
}
